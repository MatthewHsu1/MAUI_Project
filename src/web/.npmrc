# Supply chain: only install versions published more than 14 days ago.
# Malicious npm releases are typically detected and unpublished within hours to
# a few days, so a cooldown means we never resolve one. This governs lockfile
# construction only — `npm ci` replays the lockfile and is unaffected.
# Override consciously for a genuine emergency: npm install --min-release-age=0 <pkg>
min-release-age=14

# No package in this tree needs an install script (fsevents is macOS-only and
# optional). Lifecycle hooks are the main supply-chain execution vector, so
# block them. Revisit if a dependency ever legitimately needs one.
ignore-scripts=true

# openapi-typescript declares peerDependencies.typescript: ^5.x, but this repo
# pins typescript to ~6.0.2. That mismatch makes a plain `npm install` fail
# with ERESOLVE. Do NOT reach for --legacy-peer-deps to get past it: that flag
# disables peer resolution for the whole tree, not just this one conflict, and
# it silently prunes other packages' peer deps that legitimately need
# resolving (that is how @testing-library/dom and friends went missing here).
# Instead, package.json carries a scoped "overrides" entry that pins
# openapi-typescript's own view of typescript to the repo's version:
#   "overrides": { "openapi-typescript": { "typescript": "$typescript" } }
# That satisfies npm's resolver for just this one edge without touching peer
# resolution anywhere else. Remove the override if openapi-typescript ships a
# release with a typescript@6 peer range.
