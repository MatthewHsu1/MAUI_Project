# Supply chain: only install versions published more than 14 days ago.
# Malicious npm releases are typically detected and unpublished within hours to
# a few days, so a cooldown means we never resolve one. This governs lockfile
# construction only — `npm ci` replays the lockfile and is unaffected.
# Override consciously for a genuine emergency: npm install --min-release-age=0 <pkg>
min-release-age=14

# No package in this tree needs an install script (fsevents is macOS-only and
# optional). Lifecycle hooks are the main supply-chain execution vector, so
# block them. Revisit if a dependency ever legitimately needs one.
ignore-scripts=true
